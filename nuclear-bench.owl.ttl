@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix oa:      <http://www.w3.org/ns/oa#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix wd:      <http://www.wikidata.org/entity/> .
@prefix eurovoc: <http://eurovoc.europa.eu/> .
@prefix qa:      <https://w3id.org/wdaqua/qanary#> .
@prefix nb:      <https://w3id.org/nuclear-bench/> .

# -------------------------------------------------------
# Ontology metadata
# -------------------------------------------------------

<https://w3id.org/nuclear-bench/>
  a owl:Ontology ;
  dct:title       "Nuclear-Bench Ontology"@en ;
  dct:description """An OWL ontology for a knowledge-grounded annotated QnA benchmark
                     dataset in the nuclear technical domain. Q&A pairs are provided by
                     industry experts with source locations. The annotation layer maps
                     terms to Wikidata/EuroVoc and encodes everything as linked data."""@en ;
  dct:creator     "Thushari Pahalage", "Matteo Lissandrini" ;
  dct:created     "2026"^^xsd:gYear ;
  dct:license     <https://creativecommons.org/licenses/by/4.0/> ;
  dct:source      <https://github.com/ARMADA/nuclear-bench> ;
  owl:versionInfo "1.0" ;
  rdfs:seeAlso    <http://eurovoc.europa.eu/>, <http://www.wikidata.org/> .

# -------------------------------------------------------
# Core QA Classes
# -------------------------------------------------------

qa:Question a owl:Class ;
  rdfs:label "Question" ;
  rdfs:subClassOf prov:Entity .

qa:Answer a owl:Class ;
  rdfs:label "Answer" ;
  rdfs:subClassOf prov:Entity .

# -------------------------------------------------------
# Document Class
# -------------------------------------------------------

foaf:Document a owl:Class ;
  rdfs:subClassOf prov:Entity .

# -------------------------------------------------------
# Annotation Classes (from Web Annotation Model)
# -------------------------------------------------------

oa:Annotation a owl:Class .

oa:SpecificResource a owl:Class .

oa:FragmentSelector a owl:Class .

oa:TextPositionSelector a owl:Class .

# -------------------------------------------------------
# External Entity Classes (Wikidata / EuroVoc)
# Typed as skos:Concept — instantiated per Q&A pair
# -------------------------------------------------------

skos:Concept a owl:Class .
