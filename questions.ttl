#################################################
# q47  [T3 · AR_2007_0 · p.19 · AIT / 230U production]
# At what proton energy does the 232Th(p,3n)230Pa
# reaction cross section reach its maximum?
#################################################

pqa:q47 a qa:Question ;
    rdfs:label "At what proton energy does the 232Th(p,3n)230Pa reaction cross section reach its maximum?"@en ;
    schema:suggestedAnswer pqa:q47_a1 ;
    schema:acceptedAnswer  pqa:q47_a1 .

pqa:q47_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label             "19.9 ± 0.3 MeV"@en ;
    qudt:numericValue      "19.9"^^xsd:decimal ;
    qudt:standardUncertainty "0.3"^^xsd:decimal ;
    qudt:unit              unit:MegaEV ;
    # unit:MegaEV ✓ confirmed in QUDT (full RDF verified)
    rdfs:comment           "Maximum cross section at this energy: 353 ± 14.5 mb (see q41). Measurements at cyclotron of JRC-IHCP Ispra using stacked foil technique."@en ;
    prov:wasDerivedFrom    pqa:q47_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q47_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q47_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2007_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=19" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "The maximum of the 232 Th(p,3n) 230 Pa excitation function (353 ± 14.5 mb) is found at 19.9 ± 0.3 MeV proton energy."
            ]
        ]
    ] .

# NOTE: q47 and q41 share the same source sentence; q41 extracts the
# cross section (353 ± 14.5 mb), q47 extracts the peak proton energy.



