#################################################
# q25  
# What is the diffusion coefficient of U(IV) in
# molten LiF-CaF2 at 820 °C?
#################################################

pqa:q25 a qa:Question ;
    rdfs:label             "What is the diffusion coefficient of U(IV) in molten LiF-CaF2 determined at 820 °C?"@en ;
    schema:suggestedAnswer pqa:q25_a1 ;
    schema:acceptedAnswer  pqa:q25_a1 .

pqa:q25_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label             "3.7 × 10⁻⁵ cm²/s"@en ;
    qudt:numericValue      "3.7E-5"^^xsd:decimal ;
    qudt:unit              unit:CentiM2-PER-SEC ;
    # unit:CentiM2-PER-SEC ✓ confirmed (applicable unit for
    # quantitykind:AreaPerTime / DiffusionCoefficient)
    prov:wasDerivedFrom    pqa:q25_src1 ;
    prov:hadPrimarySource  pqa:AR_2010_0 .

pqa:q25_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q25_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2010_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=16" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "The diffusion coefficients evaluated from cyclic voltammetry at 820 °C are 3.710 -5 and 2.410 -5 cm 2 /s for U(IV) and U(III), respectively."
