#################################################
# q11
# At what temperature is helium released from
# irradiated fuel during Knudsen cell experiments?
#################################################

pqa:q11 a qa:Question ;
    rdfs:label               "At what temperature is helium released from irradiated fuel during Knudsen cell experiments?"@en ;
    schema:suggestedAnswer   pqa:q11_a1 ;
    schema:suggestedAnswer   pqa:q11_a2 ;
    schema:suggestedAnswer   pqa:q11_a3 ;
    schema:acceptedAnswer    pqa:q11_a1 .

#################################################
# Accepted (gold) answer

#################################################

pqa:q11_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "1250 K"@en ;
    qudt:numericValue     "1250"^^xsd:decimal ;
    qudt:unit             unit:K ;
    prov:wasDerivedFrom pqa:q11_src1 ;
    prov:hadPrimarySource pqa:AR_2003_0 .

#################################################
# Suggested candidate answers
# Other stages of helium release
#################################################

# Onset of release
pqa:q11_a2 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "900 K"@en ;
    qudt:numericValue     "900"^^xsd:decimal ;
    qudt:unit             unit:K ;
    prov:wasDerivedFrom pqa:q11_src2 ;
    prov:hadPrimarySource pqa:AR_2001_0 .

# Main / bulk release region
pqa:q11_a3 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "1650 K"@en ;
    qudt:numericValue     "1650"^^xsd:decimal ;
    qudt:unit             unit:K ;
    prov:wasDerivedFrom pqa:q11_src3 ;
    prov:hadPrimarySource pqa:AR_2001_0 .

#################################################
# Provenance annotations
#################################################

pqa:q11_src1 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q11_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2003_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=27" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """The Knudsen Cell experiments showed a release of Helium at 1250K, that corresponds to the third annealing
stage: He trapped in vacancies is released via the migration or dissociation of the vacancy-helium complexes."""
            ]
        ]
    ] .

pqa:q11_src2 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q11_a2 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2001_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=14" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """From
the release/vaporisation rates (see Fig.) of a number of components (matrix atoms, volatile-, metallic- and ceramic fission product compounds, actinides, fission gas and helium)
present in the irradiated material, one can see that the onset
of helium release occurs at approximately 900 K, but a large
part is retained up to 1650 K and above."""
            ]
        ]
    ] .

