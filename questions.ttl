        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=29" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "up to 35 GPa a mixture of 2 phases co-exist, namely Cf I (space group, P63/mmc ) and Cf II (space group, Fm3m )."
            ]
        ]
    ] .

