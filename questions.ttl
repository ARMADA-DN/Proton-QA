#################################################
# q14
# Which parent isotope is used in generator-based
# production of Ac-225 through purification processes?
#################################################

pqa:q14 a qa:Question ;
    rdfs:label               "Which parent isotope is used in generator-based production of Ac-225 through purification processes?"@en ;
    schema:suggestedAnswer   pqa:q14_a1 ;
    schema:acceptedAnswer    pqa:q14_a1 .

#################################################
# Accepted (gold) answer
#################################################

pqa:q14_a1 a qa:Answer, schema:Thing ;
    rdfs:label            "Thorium-229"@en ;
    prov:wasDerivedFrom pqa:q14_src1, pqa:q14_src2, pqa:q14_src3 ;
    prov:hadPrimarySource pqa:AR_2005_0 .

#################################################
# Provenance annotations
#################################################

