# up to 2800 K?
#################################################

pqa:q43 a qa:Question ;
    rdfs:label "Was helium gas released from the PuO2-kernel coated particle during Knudsen-cell annealing up to 2800 K?"@en ;
    schema:suggestedAnswer pqa:q43_a1 ;
    schema:acceptedAnswer  pqa:q43_a1 .

pqa:q43_a1 a qa:Answer ;
    rdfs:label             "No"@en ;
    rdf:value              "false"^^xsd:boolean ;
    rdfs:comment           "He retained in the porous graphite buffer layer by the tight SiC sealing layer. No SiC/C constituent release either before onset of vaporisation at 2400 K."@en ;
    prov:wasDerivedFrom    pqa:q43_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q43_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q43_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2007_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=49" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "No helium release could be observed even at the highest temperature (2800 K)."
            ]
        ]
    ] .

# NOTE: q43 and q39 share the same source sentence; q39 extracts the
# temperature value (T2), q43 extracts the boolean outcome (T7).

