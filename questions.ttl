# ------------------------------------------------------- 
# Dataset metadata 
# ------------------------------------------------------- 

<https://w3id.org/proton-qa/>
  a dcat:Dataset ;
  dct:title "Proton-QA Questions Dataset"@en ;
  dct:description """A knowledge-grounded annotated QnA benchmark dataset 
                      in the nuclear technical domain. Q&A pairs are provided 
                      by industry experts with source locations. The annotation 
                      layer maps questions, answers and important terms to 
                      EuroVoc and Wikidata and encodes everything as 
                      linked data."""@en ;
  dct:creator "Thushari Pahalage Dona" ,
              "Antonio Bulgheroni" ,
              "Lorenzo Fongaro" ,
              "Matteo Lissandrini" ;
  dct:created "2026"^^xsd:gYear ;
  dct:license <https://opensource.org/licenses/mit> ;
  dct:source <https://github.com/ARMADA-DN/Proton-QA> ;
  dct:conformsTo <http://eurovoc.europa.eu/> ,
                 <https://www.wikidata.org/> ;
  dcat:version "1.0" .



