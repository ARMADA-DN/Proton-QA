pqa:q49_a1 a qa:Answer ;
    rdfs:label             "Yes"@en ;
    rdf:value              "true"^^xsd:boolean ;
    rdfs:comment           "Nd concentration in salt phase remained constant throughout both electrolyses, confirming high An/Ln selectivity. Only traces of Nd found in the deposit."@en ;
