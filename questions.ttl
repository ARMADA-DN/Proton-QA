#################################################

pqa:q49 a qa:Question ;
    rdfs:label "Did the two-stage Am/Nd electrorefining process reduce the Am content in the LiCl-KCl salt from 186 mg to below 12 mg?"@en ;
    schema:suggestedAnswer pqa:q49_a1 ;
