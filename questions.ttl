#################################################
# Q5
# What is the expected lattice parameter
# for a corium sample?
#################################################

pqa:q5 a qa:Question ;
    rdfs:label            "What is the expected lattice parameter for a corium sample?"@en ;
    schema:acceptedAnswer pqa:q5_a1 ;
    schema:suggestedAnswer pqa:q5_a1 .

pqa:q5_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "5.2984 Angstrom"@en ;
    qudt:numericValue     "5.2984"^^xsd:decimal ;
    qudt:unit             unit:ANGSTROM ;
    prov:wasDerivedFrom pqa:q5_src ;
    prov:hadPrimarySource pqa:AR_2000_0 .

# Provenance annotation
pqa:q5_src a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q5_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2000_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=91" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """The X-ray diffraction of the corium pool sample indicated a
distorted cubic fluorite lattice typical of U02 but with a verysmall lattice parameter a = 5.2984 Å."""
            ]
        ]
    ] .

