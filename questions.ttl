#################################################
# q30  [T1 · AR_2008_0 · p.29 · Compressibility of Cf]
# How many crystallographic phases co-exist in
# californium metal at pressures up to 35 GPa?
#################################################

pqa:q30 a qa:Question ;
    rdfs:label "How many crystallographic phases co-exist in californium metal at pressures up to 35 GPa?"@en ;
    schema:suggestedAnswer pqa:q30_a1 ;
    schema:acceptedAnswer  pqa:q30_a1 .

pqa:q30_a1 a qa:Answer ;
    rdfs:label             "2"@en ;
    qudt:numericValue      "2"^^xsd:integer ;
    rdfs:comment           "Dimensionless count. The two phases are Cf I (space group P63/mmc, dhcp) and Cf II (space group Fm3m, fcc). Above 16 GPa the Cf II fcc phase becomes pure."@en ;
    prov:wasDerivedFrom    pqa:q30_src1 ;
    prov:hadPrimarySource  pqa:AR_2008_0 .

pqa:q30_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
