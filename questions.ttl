            rdf:value "page=7" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """In a first step Ra-225 and Ac-225 are separated from
Th-229 by anion exchange. Subsequently, Ac-225 is
separated from Ra-225 and residual traces of Th-229
by extraction chromatography."""
            ]
        ]
    ] .


pqa:q14_src3 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q14_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
