#################################################
# q10
# What are the most promising radiometric techniques
# for the measurement of minor actinides in nuclear
# safeguard applications?
#################################################

pqa:q10 a qa:Question ;
    rdfs:label               "What are the most promising radiometric techniques for the measurement of minor actinides in nuclear safeguard applications?"@en ;
    schema:suggestedAnswer   pqa:q10_a1 ;
    schema:acceptedAnswer    pqa:q10_a1 .

#################################################
# Accepted (gold) answer
# Complete list answer
#################################################

pqa:q10_a1 a qa:Answer, schema:ItemList ;
    rdfs:label            "XRF, PNCC, HRGS"@en ;
    schema:itemListOrder  schema:ItemListUnordered ;
    schema:itemListElement pqa:XRF, pqa:PNCC, pqa:HRGS ;
    rdfs:comment          "Complete enumeration; all three techniques required for full answer"@en ;
    prov:hadPrimarySource pqa:AR_2002_0 ;
    prov:hadPrimarySource pqa:AR_2004_0 .


#################################################
# Provenance annotations
#################################################

pqa:q10_src1 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q10_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2002_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=27" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Among the radiometric techniques
developed and utilized for safeguards in the conventional
fuel cycle the techniques of X-ray fluorescence analysis
(XRF), passive neutron coincidence counting (PNCC), highresolution gamma spectrometry (HRGS) and calorimetry
show the most promising potential for applications in minor
actinide assay"""
            ]
        ]
    ] .



