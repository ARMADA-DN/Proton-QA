            rdf:value "page=6" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Although several alpha-emitting nuclides have been
investigated in AIT, including Ac-225, Ra-224,
Ra-223, Bi-213, Bi-212, At-211 and Tb-149, studies
using Bi-213 (T1/2 = 46 min), that is made available to
hospitals via a radionuclide generator loaded with its
parent nuclide Ac-225 (T1/2 = 10 days), are presently
the most advanced (see Fig. 3)."""
            ]
        ]
    ] .

