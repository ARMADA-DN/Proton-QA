            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Because of its short half-life (46 min), Bi-213 must be
produced at the place of utilisation."""
            ]
        ]
    ] .

pqa:q8_src3 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q8_a3 ;
