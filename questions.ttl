#################################################
# AR_02_0 — Q1
# What is the minimum amount required for a
# Calorimetry assay of Americium?
#################################################

ex:AR_02_0_q1 a qa:Question ;
    rdfs:label            "What is the minimum amount required for a Calorimetry assay of Americium?"@en ;
    schema:acceptedAnswer ex:AR_02_0_q1_a1 .

ex:AR_02_0_q1_a1 a qa:Answer ;
    rdfs:label            "5 MicroGM"@en ;
    qudt:numericValue     "5"^^xsd:decimal ;
    qudt:unit             unit:MicroGM ;
    oa:confidence         "1.00"^^xsd:decimal ;
    prov:wasDerivedFrom   ex:AR_02_0_q1 ;
    prov:hadPrimarySource ex:AR_02_0 .

# Provenance annotation
ex:AR_02_0_q1_src a oa:Annotation ;
    oa:hasBody   ex:AR_02_0_q1_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource ex:AR_02_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=28&table=2"
        ]
    ] .

