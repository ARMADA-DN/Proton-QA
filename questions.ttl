#################################################
# q44  [T7 · AR_2007_0 · p.28 · MaRE / Environmental Particles]
# Is plutonium present exclusively at oxidation
# state +4 throughout the cross-section of the
# Marshall Islands hot particle investigated
# by µ-XANES?
#################################################

pqa:q44 a qa:Question ;
    rdfs:label "Is plutonium present exclusively at oxidation state +4 throughout the cross-section of the Marshall Islands hot particle investigated by µ-XANES?"@en ;
    schema:suggestedAnswer pqa:q44_a1 ;
    schema:acceptedAnswer  pqa:q44_a1 .

pqa:q44_a1 a qa:Answer ;
    rdfs:label             "Yes"@en ;
    rdf:value              "true"^^xsd:boolean ;
    rdfs:comment           "Pu LII absorption edge energy shows < 0.5 eV variation across the particle section. Distribution is irregular (no correlation to sample shape) but oxidation state is uniformly +4."@en ;
    prov:wasDerivedFrom    pqa:q44_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q44_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q44_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2007_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=28" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "Plutonium within the whole sample section is present at oxidation state +4, distributed irregularly, without correlation to the sample shape."
            ]
        ]
    ] .

