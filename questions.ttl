#################################################
# Q7
# Which is the dissolution rate of spent nuclear
# fuel when in contact with water?
#################################################

pqa:q7 a qa:Question ;
    rdfs:label            "Which is the dissolution rate of spent nuclear fuel when in contact with water?"@en ;
    schema:acceptedAnswer pqa:q7_a1 ;
    schema:suggestedAnswer pqa:q7_a1 ;
    schema:suggestedAnswer pqa:q7_a2 .

pqa:q7_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "6.77e-11 mol/m2/s"@en ;
    rdfs:comment          "Lower burnup light water reactor fuel"@en ;
    qudt:numericValue     "6.77e-11"^^xsd:double ;
    qudt:unit             unit:MOL-PER-M2-SEC ;
    prov:wasDerivedFrom pqa:q7_src1 ;
    prov:hadPrimarySource pqa:AR_2001_0 .

pqa:q7_a2 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "2.66e-10 mol/m2/s"@en ;
    rdfs:comment          "Higher burnup light water reactor fuel (53 MWd/KgU)"@en ;
    qudt:numericValue     "2.66e-10"^^xsd:double ;
    qudt:unit             unit:MOL-PER-M2-SEC ;
