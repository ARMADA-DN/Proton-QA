#################################################

ex:AR_00_0_q1 a qa:Question ;
    rdfs:label             "What is the melting point temperature of magnesia?"@en ;
    schema:acceptedAnswer  ex:AR_00_0_q1_a2 ;
    schema:suggestedAnswer ex:AR_00_0_q1_a1 .

ex:AR_00_0_q1_a1 a qa:Answer ;
    rdfs:label               "3250 +/- 20 K"@en ;
    qudt:numericValue        "3250"^^xsd:decimal ;
    qudt:standardUncertainty "20"^^xsd:decimal ;
    qudt:unit                unit:K ;
    oa:confidence            "0.60"^^xsd:decimal ;
    prov:wasDerivedFrom      ex:AR_00_0_q1 ;
    prov:hadPrimarySource    ex:AR_00_0 .

ex:AR_00_0_q1_a2 a qa:Answer ;
    rdfs:label               "3245 +/- 10 K"@en ;
    qudt:numericValue        "3245"^^xsd:decimal ;
