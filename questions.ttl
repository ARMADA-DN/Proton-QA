#################################################

pqa:q41 a qa:Question ;
    rdfs:label "What is the maximum cross section for the nuclear reaction 232Th(p,3n)230Pa?"@en ;
    schema:suggestedAnswer pqa:q41_a1 ;
    schema:acceptedAnswer  pqa:q41_a1 .

pqa:q41_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label             "353 ± 14.5 mb at 19.9 ± 0.3 MeV"@en ;
    qudt:numericValue      "0.353"^^xsd:decimal ;
    qudt:standardUncertainty "0.0145"^^xsd:decimal ;
    qudt:unit              unit:BARN ;
    # unit:BARN ✓ confirmed in QUDT.
    # Source reports in millibarns (mb): 353 ± 14.5 mb.
    # unit:MilliBARN not confirmed in QUDT; stored as 0.353 ± 0.0145
    # barn (1 mb = 0.001 b) per dataset convention (same as q64, q76).
    rdfs:comment           "Source: 353 ± 14.5 mb at 19.9 ± 0.3 MeV proton energy. Stored in unit:BARN (×0.001 conversion). In good agreement with Celler 1981, Kudo 1982, Roshchin 1997."@en ;
    prov:wasDerivedFrom    pqa:q41_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q41_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
