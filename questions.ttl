#################################################
# Q1
# What is the melting point temperature of magnesia?
#################################################

pqa:q1 a qa:Question ;
    rdfs:label             "What is the melting point temperature of magnesia?"@en ;
    schema:acceptedAnswer  pqa:q1_a1 ;
    schema:suggestedAnswer pqa:q1_a1 ;
    schema:suggestedAnswer  pqa:q1_a2 .


pqa:q1_a1 a qa:Answer, qudt:QuantityValue;
    rdfs:label               "3245 +/- 10 K"@en ;
    qudt:numericValue        "3245"^^xsd:decimal ;
    qudt:standardUncertainty "10"^^xsd:decimal ;
    qudt:unit                unit:K ;
    prov:wasDerivedFrom pqa:q1_src1 ;
    prov:hadPrimarySource    pqa:AR_2000_0 .

pqa:q1_a2 a qa:Answer, qudt:QuantityValue;
    rdfs:label               "3250 +/- 20 K"@en ;
    qudt:numericValue        "3250"^^xsd:decimal ;
    qudt:standardUncertainty "20"^^xsd:decimal ;
    qudt:unit                unit:K ;
    prov:wasDerivedFrom pqa:q1_src2, pqa:q1_src3 ;
    prov:hadPrimarySource    pqa:AR_2000_0 .

# Provenance annotations
pqa:q1_src1 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q1_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2000_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=20" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "Fig.3 Fitting of a spectrum taken during MgO freezing. The resulting melting temperature is 3245 K; the fitting precision gives an uncertainty of the order of 10 K."
            ]
        ]
    ] .

pqa:q1_src2 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q1_a2 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2000_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=19" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Application of this method to the investigation of MgO melting led to the unexpected conclusion that its melting point lies in the interval 3250±20 K - about 180 K
higher than the currently accepted value of 3070 K, obtained with conventional methods."""
            ]
        ]
    ] .

pqa:q1_src3 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q1_a2 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2000_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=80" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """The melting point of MgO was measured at 3250±20 K, i.e.approximately 150 K higher than previously reported in the literature."""
            ]
        ]
    ] .

# Entity linking annotations
pqa:q1_ann_magnesia a oa:Annotation ;
    oa:motivatedBy oa:identifying ;
    oa:hasBody     wd:Q214769 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:q1 ;
        oa:hasSelector [
            a oa:TextPositionSelector ;
            oa:start "41"^^xsd:nonNegativeInteger ;
            oa:end   "49"^^xsd:nonNegativeInteger ]
    ] .

pqa:q1_ann_meltingpoint a oa:Annotation ;
    oa:motivatedBy oa:identifying ;
    oa:hasBody     wd:Q15318 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:q1 ;
        oa:hasSelector [
            a oa:TextPositionSelector ;
            oa:start "12"^^xsd:nonNegativeInteger ;
            oa:end   "25"^^xsd:nonNegativeInteger ]
    ] .

pqa:q1_ann_temperature a oa:Annotation ;
    oa:motivatedBy oa:identifying ;
    oa:hasBody     wd:Q11466 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:q1 ;
        oa:hasSelector [
            a oa:TextPositionSelector ;
            oa:start "26"^^xsd:nonNegativeInteger ;
            oa:end   "37"^^xsd:nonNegativeInteger ]
    ] .



