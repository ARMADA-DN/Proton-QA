#################################################
# q50  [T7 · AR_2007_0 · p.40 · NWD / DFT He in UO2]
# Do DFT calculations predict that the
# interaction between He impurities in the UO2
# crystal is repulsive?
#################################################

pqa:q50 a qa:Question ;
    rdfs:label "Do DFT calculations predict that the interaction between He impurities in the UO2 crystal is repulsive?"@en ;
    schema:suggestedAnswer pqa:q50_a1 ;
    schema:acceptedAnswer  pqa:q50_a1 .

pqa:q50_a1 a qa:Answer ;
    rdfs:label             "Yes"@en ;
    rdf:value              "true"^^xsd:boolean ;
    rdfs:comment           "He–He interaction is repulsive, very small and short-range (incorporation energy 0.6–0.8 eV). Proper estimate requires spin polarisation. Contrast with q97 which quantifies the energy range."@en ;
    prov:wasDerivedFrom    pqa:q50_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q50_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q50_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2007_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=40" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "the interaction between He impurities in the UO 2 crystal is very small, repulsive (incorporation energy 0.6-0.8 eV), and has a very short range."
            ]
        ]
    ] .

# NOTE: q50 and q97 share the same source sentence; q97 extracts
# the numeric energy range (T4), q50 extracts the boolean character
# (repulsive vs attractive) as a yes/no answer (T7).

