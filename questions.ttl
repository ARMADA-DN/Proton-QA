    qudt:numericValue     "45"^^xsd:decimal ;
    qudt:unit             unit:MIN ;
    prov:wasDerivedFrom pqa:q8_src1 ;
    prov:hadPrimarySource pqa:AR_2001_0 .

pqa:q8_a2 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "46 min"@en ;
    qudt:numericValue     "46"^^xsd:decimal ;
    qudt:unit             unit:MIN ;
    prov:wasDerivedFrom pqa:q8_src2, pqa:q8_src4, pqa:q8_src5 ;
    prov:hadPrimarySource pqa:AR_2002_0 ;
    prov:hadPrimarySource pqa:AR_2006_0 .

