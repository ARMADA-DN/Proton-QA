    schema:acceptedAnswer    pqa:q16_a1 .

#################################################
# Accepted (gold) answer
#################################################

pqa:q16_a1 a qa:Answer, schema:Thing ;
    rdfs:label            "Plutonium-242"@en ;
    prov:wasDerivedFrom pqa:q16_src1 ;
    prov:hadPrimarySource pqa:AR_2004_0 .

#################################################
# Provenance annotation
#################################################

pqa:q16_src a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q16_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2004_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=12" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """The use of the 242
Pu isotope, which has a much lower activity than 239Pu, means
that the samples with 242Pu may be cooled to lower temperatures than those with 239
Pu, and, equally importantly,
neutron experiments can be performed whereas the slow
neutron fission cross section of 239
Pu is too high."""
            ]
        ]
    ] .

