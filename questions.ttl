#################################################
# q45  [T2 · AR_2007_0 · p.33 · FAR / NpNiSi2]
# What is the ferromagnetic Curie temperature
# TC of NpNiSi2?
#################################################

pqa:q45 a qa:Question ;
    rdfs:label "What is the ferromagnetic Curie temperature TC of NpNiSi2?"@en ;
    schema:suggestedAnswer pqa:q45_a1 ;
    schema:acceptedAnswer  pqa:q45_a1 .

pqa:q45_a1 a qa:Answer, qudt:QuantityValue ;
    rdfs:label             "51.5 K"@en ;
    qudt:numericValue      "51.5"^^xsd:decimal ;
    qudt:unit              unit:K ;
    # unit:K ✓ confirmed in QUDT
    rdfs:comment           "Confirmed by specific heat and resistivity anomaly. Saturated moment μsat ≈ 1.07 μB, ordered moment from Mössbauer μNp = 1.4 μB."@en ;
    prov:wasDerivedFrom    pqa:q45_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q45_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q45_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2007_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=33" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "the onset of ferromagnetic order below T C = 51.5 K (Fig.1)"
            ]
        ]
    ] .

