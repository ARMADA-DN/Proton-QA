            rdf:value "page=43" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "The ion maps in Fig. 2 confirm that the pores of the high burn-up structure contain both Xe and Kr."
            ]
        ]
    ] .

