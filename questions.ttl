            rdf:value "page=19" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "The maximum of the 232 Th(p,3n) 230 Pa excitation function (353 ± 14.5 mb) is found at 19.9 ± 0.3 MeV proton energy."
            ]
