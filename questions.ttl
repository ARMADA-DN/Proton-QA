        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=38" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Because of
the short half-life of 213Bi (45 min), 213Bi labelled peptides and
Fab-fragments are required for fast localisation on the tumour."""
            ]
        ]
    ] .

pqa:q8_src2 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q8_a2 ;
