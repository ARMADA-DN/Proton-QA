#################################################
# q8
# What is the half-life of 213Bi?
#################################################

pqa:q8 a qa:Question ;
    rdfs:label               "What is the half-life of 213Bi?"@en ;
    schema:suggestedAnswer   pqa:q8_a1 ;
    schema:suggestedAnswer   pqa:q8_a2 ;
    schema:suggestedAnswer   pqa:q8_a3 ;
    schema:acceptedAnswer    pqa:q8_a3 .

#################################################
# Accepted (gold) answer
# Most precise value and closest to recommended nuclear data
#################################################

pqa:q8_a3 a qa:Answer, qudt:QuantityValue ;
    rdfs:label            "45.6 min"@en ;
    qudt:numericValue     "45.6"^^xsd:decimal ;
    qudt:unit             unit:MIN ;
    prov:wasDerivedFrom pqa:q8_src3 ;
    prov:hadPrimarySource pqa:AR_2003_0 .

#################################################
# Alternative suggested answers
#################################################

