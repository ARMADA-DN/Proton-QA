        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=6" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Th-229 was purified using
repeated ion exchange procedures and was loaded
onto Dowex 1x8 anion exchange resin to prepare the
Th-229 “cow“ that has been in use for more than 1
decade for continuous production of Ac-225."""
            ]
        ]
    ] .

pqa:q14_src2 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q14_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
