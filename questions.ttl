#################################################
# q35  [T7 · AR_2008_0 · p.28–29 · NWD / Actinide High Oxides]
# Is Np2O3 stable as a bulk phase during
# oxidation of neptunium metal?
#################################################

pqa:q35 a qa:Question ;
    rdfs:label "Is Np2O3 stable as a bulk phase during oxidation of neptunium metal?"@en ;
    schema:suggestedAnswer pqa:q35_a1 ;
    schema:acceptedAnswer  pqa:q35_a1 .

pqa:q35_a1 a qa:Answer ;
    rdfs:label             "No"@en ;
    rdf:value              "false"^^xsd:boolean ;
    rdfs:comment           "Np2O3 is stable only as a surface phase (~8 monolayers thick), not as a bulk phase. It is replaced by NpO2 at higher O2 dosage. Contrast with Pu, where the sesquioxide forms as stable bulk phase."@en ;
    prov:wasDerivedFrom    pqa:q35_src1 ;
    prov:hadPrimarySource  pqa:AR_2008_0 .

pqa:q35_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
    oa:hasBody   pqa:q35_a1 ;
    oa:hasTarget [
        a oa:SpecificResource ;
        oa:hasSource pqa:AR_2008_0 ;
        oa:hasSelector [
            a oa:FragmentSelector ;
            dct:conformsTo <http://tools.ietf.org/rfc/rfc5147> ;
            rdf:value "page=29" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact "Np 2 O3 is stable only as surface phase."
            ]
        ]
    ] .

