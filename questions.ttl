            rdf:value "page=61" ;
            oa:refinedBy [
                a oa:TextQuoteSelector ;
                oa:exact """Low-molecular peptides are ideal carrier molecules in combination with relatively short-lived 213Bi (T1/2 = 46min) due to their relatively fast diffusion and rapid tumour targeting"""
            ]
        ]
    ] .

pqa:q8_src5 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
