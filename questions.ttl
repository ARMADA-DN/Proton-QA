# q42  [T6 · AR_2007_0 · p.43 · SCNF / SIMS fission gas]
# Which fission gases were found co-existing in
# the pores of the high burn-up structure in
# the UO2 fuel pellet rim?
#################################################

pqa:q42 a qa:Question ;
    rdfs:label "Which fission gases were found co-existing in the pores of the high burn-up structure in the UO2 fuel pellet rim?"@en ;
    schema:suggestedAnswer pqa:q42_a1 ;
    schema:acceptedAnswer  pqa:q42_a1 .

pqa:q42_a1 a qa:Answer ;
    rdfs:label             "{Xe, Kr}"@en ;
    pqa:hasAnswerMember    wd:Q1006 ;   # xenon   (element 54)
    pqa:hasAnswerMember    wd:Q888 ;    # krypton (element 36)
    rdfs:comment           "Unordered set. First experimental evidence of Kr and Xe co-existing in HBS pores. Detected via SIMS ion maps for 133Cs and 85Rb (decay products of 133Xe and 85Kr)."@en ;
    prov:wasDerivedFrom    pqa:q42_src1 ;
    prov:hadPrimarySource  pqa:AR_2007_0 .

pqa:q42_src1 a oa:Annotation ;
    oa:motivatedBy oa:highlighting ;
