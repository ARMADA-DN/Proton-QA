                a oa:TextQuoteSelector ;
                oa:exact """Alpha-emitters with short half-lives such as 213
Bi (t1/2 = 45.6
min) provided by ITU in form of 225Ac/213Bi generators are
appropriate in their application to readily accessible tumours."""
            ]
        ]
    ] .



pqa:q8_src4 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
    oa:hasBody   pqa:q8_a2 ;
    oa:hasTarget [
