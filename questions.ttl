                a oa:TextQuoteSelector ;
                oa:exact """The FPT2 test was performed under low steam flow conditions to simulate the reducing conditions that could occur withlarge H2 production. In the tests, a 20 x 1m-rod bun-dle of irradiated fuel (burn-up: ~35 MWd/kgU) wasoverheated and allowed to degrade and release thefission products, which were captured downstream inan instrumented, simulated primary circuit."""
            ]
        ]
    ] .

pqa:q15_src2 a oa:Annotation ;
    oa:motivatedBy oa:linking ;
