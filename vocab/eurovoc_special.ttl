@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix ex:   <http://example.org/> .

# -------------------------------------------------------
# Custom Concept Scheme
# -------------------------------------------------------
ex:NuclearBenchVocabulary a skos:ConceptScheme ;
    rdfs:label      "Nuclear-Bench Custom Vocabulary"@en ;
    dct:description "Custom concepts where no external entity exists in EuroVoc or Wikidata"@en ;
    dct:created     "2026"^^xsd:gYear .

# -------------------------------------------------------
# AR_016 Q1 — dissolution rate
# lattice param
# -------------------------------------------------------
ex:DissolutionRate a skos:Concept ;
    skos:prefLabel "Dissolution rate"@en ;
    skos:definition "The rate at which a solid substance dissolves in a liquid, expressed in mol/m2/s"@en ;
    skos:scopeNote  "Used in context of spent nuclear fuel dissolution in groundwater"@en ;
    skos:inScheme   ex:NuclearBenchVocabulary .

# -------------------------------------------------------
# AR_017 Q2 — plutonium superconducting compounds
# -------------------------------------------------------
ex:PuCoGa5 a skos:Concept ;
    skos:prefLabel "PuCoGa5"@en ;
    skos:definition "Plutonium-cobalt-gallium intermetallic compound exhibiting superconductivity at 18K"@en ;
    skos:scopeNote  "Transition temperature 18K, critical magnetic field 740 kOe"@en ;
    skos:inScheme   ex:NuclearBenchVocabulary .

ex:PuRhGa5 a skos:Concept ;
    skos:prefLabel "PuRhGa5"@en ;
    skos:definition "Plutonium-rhodium-gallium intermetallic compound exhibiting superconductivity at 8.6K"@en ;
    skos:scopeNote  "Transition temperature 8.6K, critical magnetic field 210 kOe"@en ;
    skos:inScheme   ex:NuclearBenchVocabulary .
